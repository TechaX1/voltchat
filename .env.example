# Copy to .env to get started: `cp .env.example .env` (.env is gitignored)
# Every key below is parsed + validated by src/config.ts (zod). See docs/THEMING.md.

# Backend Configuration
VITE_WEBHOOK_URL=http://localhost:9732/chat # Your AI backend webhook URL (leave empty for demo mode)
VITE_API_TOKEN= # Optional API token for authentication (sent as `Authorization: Bearer <token>`)
VITE_UPLOAD_URL=http://localhost:9732/upload # URL for file uploads
# Demo mode: auto (demo when no webhook URL) | on (always demo) | off (never demo)
VITE_DEMO_MODE=auto

# Application Branding
VITE_APP_NAME=VoltChat # Name of the application
VITE_APP_DESCRIPTION=A high-performance, developer-focused chat interface for custom AI backends. # Meta description
VITE_APP_LOGO_URL= # URL to the application logo (empty = default icon)
VITE_FAVICON_URL=/favicon.svg # Path to the favicon

# Feature Flags & Defaults
VITE_ENABLE_UPLOADS=true # true | false - Enable or disable file upload features
VITE_MAX_ATTACHMENTS=5 # Maximum number of attachments permitted
VITE_DEFAULT_THEME=dark # light | dark | deep-dark - The default theme for new users
